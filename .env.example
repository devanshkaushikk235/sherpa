# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NOTE: Never commit your real .env file with secrets to GitHub.
# ==============================================================================

# 1. Supabase PostgreSQL Configuration (Free Live Deployment)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"

# 2. Snowflake Cloud Data Warehouse (Enterprise Medallion Architecture)
SNOWFLAKE_ACCOUNT="your-account-locator"
SNOWFLAKE_USER="your-username"
SNOWFLAKE_PASSWORD="your-password"
SNOWFLAKE_ROLE="LIVEOPS_ENGINEER"
SNOWFLAKE_WAREHOUSE="LIVEOPS_WH"
SNOWFLAKE_DATABASE="LIVEOPS_DW"
SNOWFLAKE_SCHEMA="RAW"

